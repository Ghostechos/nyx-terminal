{
  "name": "nyx-terminal",
  "productName": "Nyx Terminal",
  "version": "0.4.0",
  "description": "Un terminal moderne pour Windows (Electron + xterm.js + ConPTY)",
  "main": "main.js",
  "author": "PIYAS (alias Ghosty)",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "dist:installer": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "dist:dir": "electron-builder --win --dir"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.nyx.terminal",
    "productName": "Nyx Terminal",
    "copyright": "Copyright © 2026 PIYAS (alias Ghosty) — MIT",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "shell/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nyx Terminal",
      "artifactName": "NyxTerminal-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "NyxTerminal-Portable-${version}.${ext}"
    }
  },
  "homepage": "https://github.com/Ghostechos/nyx-terminal",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ghostechos/nyx-terminal.git"
  }
}
